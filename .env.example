# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret for signing administrative authentication tokens
JWT_SECRET="plsms-super-secret-enterprise-key-2026"

# GOOGLE_SERVICE_ACCOUNT_EMAIL: Service Account email for private Google Sheets synchronization proxy
GOOGLE_SERVICE_ACCOUNT_EMAIL="plsms-sync-proxy@plsms-sync-proxy.iam.gserviceaccount.com"

# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY / GOOGLE_PRIVATE_KEY: RSA private key for the Google Cloud Service Account (PEM format with \n or actual newlines)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_PRIVATE_KEY=""

# GOOGLE_SERVICE_ACCOUNT_KEY: Optional alternative - full JSON credentials key string from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_KEY=""

# GOOGLE_SPREADSHEET_ID: The Google Spreadsheet ID or full URL
GOOGLE_SPREADSHEET_ID=""

# GOOGLE_SHEET_TAB_NAME: The specific tab/worksheet name inside the Spreadsheet
GOOGLE_SHEET_TAB_NAME=""

# GOOGLE_SHEETS_WEBAPP_URL: Optional Google Apps Script Webhook URL for direct webhooks
GOOGLE_SHEETS_WEBAPP_URL=""

# DATABASE_URL: Managed PostgreSQL connection string (Cloud SQL / external PostgreSQL)
# Example: postgres://username:password@hostname:5432/plsms_db?sslmode=require
DATABASE_URL=""

