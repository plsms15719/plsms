# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret for signing administrative authentication tokens
JWT_SECRET="plsms-super-secret-enterprise-key-2026"

# GOOGLE_SERVICE_ACCOUNT_EMAIL: Service Account email for private Google Sheets synchronization proxy
GOOGLE_SERVICE_ACCOUNT_EMAIL="plsms-sync-proxy@nepal-transport-gov.iam.gserviceaccount.com"

# GOOGLE_PRIVATE_KEY: RSA private key for the Google Cloud Service Account (PEM format with \n or actual newlines)
GOOGLE_PRIVATE_KEY=""

# GOOGLE_SERVICE_ACCOUNT_KEY: Optional alternative - full JSON credentials key string
GOOGLE_SERVICE_ACCOUNT_KEY=""

